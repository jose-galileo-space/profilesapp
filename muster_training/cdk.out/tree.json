.257.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::Lambda::Function","aws:cdk:cloudformation:logicalId":"AttachProfileFn51C2C9F9","aws:cdk:cloudformation:props":{"code":{"zipFile":"\nimport boto3, json\n\ndef handler(event, context):\n    ec2 = boto3.client('ec2')\n    instance_id = event['ResourceProperties']['InstanceId']\n    profile_arn = event['ResourceProperties']['ProfileArn']\n    request_type = event['RequestType']\n\n    if request_type in ('Create', 'Update'):\n        # Detach existing profile if any\n        try:\n            assocs = ec2.describe_iam_instance_profile_associations(\n                Filters=[{'Name': 'instance-id', 'Values': [instance_id]},\n                         {'Name': 'state', 'Values': ['associated']}]\n            )['IamInstanceProfileAssociations']\n            for a in assocs:\n                ec2.disassociate_iam_instance_profile(AssociationId=a['AssociationId'])\n        except Exception:\n            pass\n        ec2.associate_iam_instance_profile(\n            IamInstanceProfile={'Arn': profile_arn},\n            InstanceId=instance_id\n        )\n    return {'PhysicalResourceId': f'{instance_id}-profile'}\n"},"handler":"index.handler","role":{"Fn::GetAtt":["AttachProfileFnServiceRoleC7C06411","Arn"]},"runtime":"python3.11","timeout":60}}}}},"AttachIamProfile":{"id":"AttachIamProfile","path":"MusterTrainingStack/AttachIamProfile","constructInfo":{"fqn":"aws-cdk-lib.custom_resources.AwsCustomResource","version":"2.257.0"},"children":{"Provider":{"id":"Provider","path":"MusterTrainingStack/AttachIamProfile/Provider","constructInfo":{"fqn":"aws-cdk-lib.aws_lambda.SingletonFunction","version":"2.257.0"}},"Resource":{"id":"Resource","path":"MusterTrainingStack/AttachIamProfile/Resource","constructInfo":{"fqn":"aws-cdk-lib.CustomResource","version":"2.257.0"},"children":{"Default":{"id":"Default","path":"MusterTrainingStack/AttachIamProfile/Resource/Default","constructInfo":{"fqn":"aws-cdk-lib.CfnResource","version":"2.